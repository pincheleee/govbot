# --- Brokerage ---
BROKERAGE=alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- Data Feed API Keys ---
SAM_GOV_API_KEY=                    # From api.data.gov
CONGRESS_API_KEY=                   # From api.congress.gov
SEC_USER_AGENT="GovBot research@example.com"
QUIVERQUANT_API_TOKEN=               # From api.quiverquant.com (Congress trading feed)
CONGRESS_TRADE_MIN_AMOUNT=15000      # Min trade amount to generate signal ($)

# --- AI Providers ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=anthropic
AI_ENSEMBLE_PROVIDERS=anthropic,deepseek

# --- Trading Parameters ---
PAPER_MODE=true
INITIAL_CAPITAL=10000
MAX_POSITION_PCT=0.10
MAX_CONCURRENT_POSITIONS=5
MIN_CONFIDENCE=75
MIN_EDGE=0.05
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.08
TRAILING_STOP_PCT=0.02
TRAILING_STOP_ACTIVATION_PCT=0.03
MAX_HOLD_HOURS=72

# --- Scan Parameters ---
SCAN_INTERVAL_MINUTES=15
MIN_CONTRACT_VALUE=50000000
MIN_MARKET_CAP=500000000
MAX_MARKET_CAP=0

# --- Notifications ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=bot.log

# --- Paths ---
DATA_DIR=data
